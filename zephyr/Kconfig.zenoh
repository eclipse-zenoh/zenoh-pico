config ZENOH_PICO_FRAG_MAX_SIZE
	int "Use this to override the maximum size for fragmented messages"
	default 4096
	help
	  Use this to override the maximum size for fragmented messages

config ZENOH_PICO_BATCH_UNICAST_SIZE
	int "Use this to override the maximum unicast batch size"
	default 2048
	help
	  Use this to override the maximum unicast batch size

