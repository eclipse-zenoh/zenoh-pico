config ZENOH_PICO_CONFIG_SOCKET_TIMEOUT
	int "Default socket timeout in milliseconds"
	default 100
	help
	  Default socket timeout in milliseconds

config ZENOH_PICO_TRANSPORT_LEASE
	int "Link lease duration in milliseconds to announce to other zenoh nodes"
	default 10000
	help
	  Link lease duration in milliseconds to announce to other zenoh nodes

config ZENOH_PICO_TRANSPORT_LEASE_EXPIRE_FACTOR
	int "Default session lease expire factor."
	default 3
	help
	  Default session lease expire factor.

config ZENOH_PICO_RUNTIME_MAX_TASKS
	int "Maximum number of tasks in zenoh-pico's runtime"
	default 64
	help
	  Maximum number of tasks in zenoh-pico's runtime

config ZENOH_PICO_RUNTIME_IDLE_READ_TASK_SLEEP
	int "Idle read task sleep duration in milliseconds."
	default 0
	help
	  Idle read task sleep duration in milliseconds.

config ZENOH_PICO_TRANSPORT_ACCEPT_TIMEOUT
	int "Link accept timeout in P2P mode in milliseconds"
	default 1000
	help
	  Link accept timeout in P2P mode in milliseconds

config ZENOH_PICO_TRANSPORT_CONNECT_TIMEOUT
	int "Link connect timeout in P2P mode in milliseconds"
	default 10000
	help
	  Link connect timeout in P2P mode in milliseconds

config ZENOH_PICO_MAX_KEYEXPR_LENGTH
	int "Maximum key expression length accepted by zenoh-pico."
	default 256
	help
	  Maximum key expression length accepted by zenoh-pico.

